# ==============================================================================
# NexusNode Appliance — Environment Variables Template
# Copy this file to .env and adjust values for your deployment
# ==============================================================================

# Core Security & Passwords
# NEXUS_SECRET_KEY: 64-character hex string for signing session tokens
SECRET_KEY=your_secure_random_secret_key_hex_here

# NEXUS_ADMIN_PASSWORD: Used ONLY during first-time database creation.
# It will NEVER overwrite an existing database admin password on container restart.
NEXUS_ADMIN_PASSWORD=Admin@1234

# Network Configuration
NEXUS_HOST=0.0.0.0
NEXUS_PORT=5000

# AI / Ollama Service Discovery
# In Docker Compose, this routes to the dedicated ollama container
OLLAMA_HOST=http://ollama:11434

# Storage & Memory Configuration
NEXUS_STORAGE_DIR=/app/storage_vault
NEXUS_MAX_HEAVY_CONCURRENCY=1
NEXUS_PASSWORD_KDF_ITERATIONS=100000
NEXUS_LOCKOUT_THRESHOLD=5
NEXUS_LOCKOUT_DURATION=600

# Google Calendar & UPES Timetable Sync Integration
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
TIMETABLE_TIMEZONE=Asia/Kolkata
TIMETABLE_SYNC_INTERVAL_SECONDS=10800

