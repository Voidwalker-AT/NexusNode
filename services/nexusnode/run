#!/data/data/com.termux/files/usr/bin/sh
# Service definition for NexusNode WSGI Server (runit / termux-services)
exec 2>&1

export PREFIX="/data/data/com.termux/files/usr"
export HOME="/data/data/com.termux/files/home"
export PATH="$PREFIX/bin:$HOME/.local/bin:$PATH"
export PYTHONPATH="$HOME/server:$PYTHONPATH"

SERVER_DIR="$HOME/server"
if [ ! -d "$SERVER_DIR" ]; then
    SERVER_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
fi

cd "$SERVER_DIR" || exit 1

# Prevent tight restart storm (Backoff: 2s)
sleep 2

echo "[nexusnode:run] Starting NexusNode WSGI Server on port 5000..."
exec python "$SERVER_DIR/app.py"
